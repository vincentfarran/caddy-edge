# Custom Caddy edge build = Caddy v2.11.4 + mholt/caddy-l4 + sablierapp sablier plugin.
# Combines what used to be two separate images (caddy-l4, caddy-sablier) into the single
# binary the HK edge needs (it uses layer4 routes AND Sablier scale-to-zero). See README.
#
# sablier moved to github.com/sablierapp/sablier-caddy-plugin: the monorepo path this was
# previously pinned to (github.com/sablierapp/sablier/plugins/caddy) was deleted from
# upstream in commit 6d880928c7ec, 2h after the commit this used to pin ("fix!: remove
# plugins from the repository", 2025-11-09) — the old path has no newer revision as of
# 2025-11-09's removal (checked 2026-09-24). The plugin now lives in its own actively maintained repo with real semver
# tags. Verified compatible before bumping: module ID unchanged (http.handlers.sablier),
# config.go (the Caddyfile/JSON directive schema) is byte-identical to the frozen commit,
# so caddy.json needs no changes. main.go only adds Caddy placeholder expansion in
# names/group and propagates errors it used to swallow — additive, not breaking.
#
# Everything is pinned so a rebuild — including the weekly cron in publish.yml — is
# reproducible: builder base, Caddy core (the `v2.11.4` arg to xcaddy), both plugin
# versions, and the runtime base. Bump deliberately; never widen a pin to a floating tag.
# Versions were read from `caddy build-info` on the proven HK/UbuntuVM binaries.
FROM caddy:2.11.4-builder AS builder
RUN xcaddy build v2.11.4 \
    --with github.com/mholt/caddy-l4@v0.1.2 \
    --with github.com/sablierapp/sablier-caddy-plugin@v1.0.2

FROM caddy:2.11.4-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# Build-time gate: fail the build (before it is ever pushed) if either plugin did not
# compile in or the core version drifted. This is the whole point of the repo — no silent
# drift onto the box that terminates every public HK route.
RUN caddy version | grep -q 'v2.11.4' \
    && caddy list-modules | grep -q '^layer4$' \
    && caddy list-modules | grep -q '^http.handlers.sablier$'
